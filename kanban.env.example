# 企业微信凭据（由管理员填写，权限必须是 600）
# 填写方式：把等号后面的占位符替换成真实值，不要加引号，不要有空格

# 企业ID（企业微信管理后台 -> 我的企业 -> 企业信息 -> 最下方「企业ID」，ww 开头）
QYWX_CORP_ID=请填写企业ID

# 自建应用 Secret（企业微信管理后台 -> 应用管理 -> 自建应用 -> Secret -> 查看）
QYWX_AGENT_SECRET=请填写应用Secret

# 自建应用 AgentId（企业微信管理后台 -> 应用管理 -> 自建应用 -> AgentId）
QYWX_AGENT_ID=请填写AgentId

# 可选：允许访问的 UserId 白名单，逗号分隔（优先级高于 allowlist.txt）
# 留空则读取同目录 allowlist.txt 文件
# KANBAN_ALLOWLIST=ZhangSan,LiSi

# 可选：会话签名密钥（缺省自动生成并保存到 .session_key）
# KANBAN_SESSION_KEY=

# 可选：监听端口（默认 8899）
# KANBAN_PORT=8899
